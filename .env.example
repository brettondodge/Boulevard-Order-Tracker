SESSION_SECRET=replace-with-a-long-random-secret
APP_PORT=3000
PREVIEW_MODE=true
DEMO_ADMIN_PASSWORD=admin123
DEMO_STAFF_PASSWORD=staff123

# Freeport reuses these existing sessions, roles and databases. No new account.
# Local optional database directory; keep outside tracked files.
# SQLITE_DATA_DIR=/absolute/private/development-directory
# Production uses existing DATABASE_URL and Cloudflare Access configuration.
# APP_PORT may be changed if port 3000 is already occupied.
